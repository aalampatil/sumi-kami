DATABASE_URL=postgres://postgres:postgres@localhost:5432/sumikami_dev
BASE_URL=http://localhost:8000
NODE_ENV=development
PORT=8000


# Tenant queries require a separate non-owner builder_runtime login.
TENANT_DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTHORIZED_PARTIES=http://localhost:3001,http://127.0.0.1:3001

# Production attachments require an absolute private path on persistent storage.
# Development defaults to .data/uploads under the API directory.
# UPLOAD_DIRECTORY=/var/lib/sumikami/uploads
